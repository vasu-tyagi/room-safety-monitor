# Hugging Face token — get from huggingface.co/settings/tokens
# Read access required for Inference Providers (Qwen 2.5 VL 72B)
# Leave blank to use stub mode (pipeline still runs end-to-end)
HF_TOKEN=

# Postgres connection string — matches deploy/docker-compose.yml defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/room_safety

# VLM mode:
#   real  — always calls HF Inference Providers; fails if HF_TOKEN is missing
#   auto  — calls HF if token is present, falls back to stub if not (quickstart default)
#   stub  — never calls HF; uses deterministic stub output
VLM_MODE=auto

# Allowed CORS origin for the dashboard
DASHBOARD_ORIGIN=http://localhost:3000
